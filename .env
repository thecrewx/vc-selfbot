# Comma-separated Discord account tokens (one per bot, up to any number)
TOKENS=token1,token2,token3

# Command name for each token (same order as TOKENS)
# e.g. bot1 means type !bot1 to control only that account
COMMANDS=bot1,bot2,bot3

# Command prefix
PREFIX=!

# Your Discord user ID(s) — comma-separated for multiple owners
# Enable Developer Mode → right-click your name → Copy User ID
OWNER_ID=your_discord_user_id

# ── Auto-Join (optional) ──────────────────────────────────────────────────────
# All bots auto-join this VC on startup and re-join if kicked
# Right-click a voice channel → Copy Channel ID
AUTO_JOIN_GUILD_ID=
AUTO_JOIN_VC_ID=

# ── Presence (optional) ───────────────────────────────────────────────────────
# online | idle | dnd | invisible
STATUS=online

# Activity text shown as "Playing ..."  (leave blank to disable)
ACTIVITY_TEXT=
# PLAYING | STREAMING | LISTENING | WATCHING | COMPETING
ACTIVITY_TYPE=PLAYING

# ── Tweaks ────────────────────────────────────────────────────────────────────
# Keepalive ping interval in ms (default 12000 = 12s)
KEEPALIVE_MS=12000

# Delay between each bot joining (ms) — avoids rate limits
JOIN_DELAY_MS=1200

# Auto-delete command messages? true | false
DELETE_COMMANDS=false

# Delay before deleting the command message (ms)
DELETE_DELAY_MS=3000

# AFK auto-reply text
AFK_REPLY=💤 AFK — brb

# ── Logging ───────────────────────────────────────────────────────────────────
# Mirror console output to a log file? true | false
LOG_TO_FILE=false
LOG_FILE=logs/bot.log
